# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Comma-separated exact origins or wildcard rules. Wildcards match one hostname label.
# Example: https://studyhive.vercel.app,https://*.vercel.app
CLIENT_URLS=https://*.vercel.app

# Supabase (the service-role key must never be exposed to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stream API
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret
