# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Comma-separated exact origins or wildcard rules. Wildcards match one hostname label.
# Example: https://studyhive.vercel.app,https://*.vercel.app
CLIENT_URLS=https://*.vercel.app

# Supabase (the service-role key must never be exposed to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stream API
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Structured logging and error aggregation (optional locally)
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Gemini-powered chat catch-up (backend only; never use a VITE_ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=12000
AI_DIGEST_RATE_LIMIT=5
AI_DIGEST_RATE_WINDOW_MS=600000
AI_DIGEST_CACHE_TTL_MS=300000

# Real Supabase RLS integration tests (use a disposable test project)
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
